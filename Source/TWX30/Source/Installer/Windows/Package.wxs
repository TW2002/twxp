<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="twxproxy 3.0.1"
           Manufacturer="twxproxy"
           Version="$(var.ProductVersion)"
           UpgradeCode="$(var.UpgradeCode)"
           Language="1033"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of TWX Proxy is already installed."
            AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="MtcShortcutIcon" SourceFile="$(var.MtcIconPath)" />
    <Icon Id="TwxpShortcutIcon" SourceFile="$(var.TwxpIconPath)" />
    <Property Id="ARPPRODUCTICON" Value="TwxpShortcutIcon" />

    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtfPath)" />
    <Property Id="PROGRAMROOTDIR" Value="$(var.ProgramDirDefault)">
      <RegistrySearch Id="FindInstalledProgramDir"
                      Root="HKLM"
                      Key="Software\TWXProxy\TWX30"
                      Name="ProgramDir"
                      Type="raw" />
    </Property>
    <ui:WixUI Id="WixUI_FeatureTree" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLROOT" Name="TWXProxy">
        <Directory Id="MTCAPPDIR" Name="MTC" />
        <Directory Id="TWXPAPPDIR" Name="TWXP" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="TWXSTARTMENUDIR" Name="TWX Proxy" />
    </StandardDirectory>
    <StandardDirectory Id="CommonStartupFolder" />

    <StandardDirectory Id="TARGETDIR">
      <Directory Id="PROGRAMROOTDIR" Name="twxproxy" ComponentGuidGenerationSeed="{A5A0D0D8-486C-43C2-9803-B07D8D34744C}">
        <Directory Id="BINDIR" Name="bin" />
        <Directory Id="SCRIPTSDIR" Name="scripts" />
        <Directory Id="TOOLSDIR" Name="tools">
          <Directory Id="TWXDBASSISTANTDIR" Name="twxdb-assistant" />
        </Directory>
        <Directory Id="DATADIR" Name="data" />
        <Directory Id="LOGSDIR" Name="logs" />
        <Directory Id="MODULESDIR" Name="modules" />
      </Directory>
    </StandardDirectory>

    <!-- Always-installed base: ProgramDir folder, registry, data/logs/modules/start-menu dirs -->
    <ComponentGroup Id="BasePayload">
      <Component Directory="PROGRAMROOTDIR" Guid="*">
        <CreateFolder />
        <RegistryValue Root="HKLM"
                       Key="Software\TWXProxy\TWX30"
                       Name="ProgramDir"
                       Type="string"
                       Value="[PROGRAMROOTDIR]"
                       KeyPath="yes" />
        <RegistryValue Root="HKLM"
                       Key="Software\TWXProxy\TWX30"
                       Name="InstallDir"
                       Type="string"
                       Value="[INSTALLROOT]" />
        <RegistryValue Root="HKLM"
                       Key="Software\TWXProxy\TWX30"
                       Name="ScriptsDir"
                       Type="string"
                       Value="[SCRIPTSDIR]" />
      </Component>

      <Component Directory="DATADIR" Guid="*">
        <CreateFolder />
        <RegistryValue Root="HKLM"
                       Key="Software\TWXProxy\TWX30\Folders"
                       Name="data"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <Component Directory="LOGSDIR" Guid="*">
        <CreateFolder />
        <RegistryValue Root="HKLM"
                       Key="Software\TWXProxy\TWX30\Folders"
                       Name="logs"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <Component Directory="MODULESDIR" Guid="*">
        <CreateFolder />
        <RegistryValue Root="HKLM"
                       Key="Software\TWXProxy\TWX30\Folders"
                       Name="modules"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <Component Directory="BINDIR" Guid="*">
        <CreateFolder />
        <RegistryValue Root="HKLM"
                       Key="Software\TWXProxy\TWX30\Folders"
                       Name="bin"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <Component Directory="SCRIPTSDIR" Guid="*">
        <CreateFolder />
        <RegistryValue Root="HKLM"
                       Key="Software\TWXProxy\TWX30\Folders"
                       Name="scripts"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <Component Directory="TOOLSDIR" Guid="*">
        <CreateFolder />
        <RegistryValue Root="HKLM"
                       Key="Software\TWXProxy\TWX30\Folders"
                       Name="tools"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <Component Directory="TWXSTARTMENUDIR" Guid="*">
        <CreateFolder />
        <RemoveFolder Id="RemoveTwxStartMenuDir" On="uninstall" />
        <RegistryValue Root="HKLM"
                       Key="Software\TWXProxy\TWX30\Folders"
                       Name="startmenu"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Mayhem Tradewars Client -->
    <ComponentGroup Id="MtcPayload">
      <Component Directory="MTCAPPDIR" Guid="*">
        <File Id="MtcExeFile"
              Source="$(var.PayloadRoot)\MTC\MTC.exe"
              KeyPath="yes"
              Checksum="yes">
          <Shortcut Id="MtcStartMenuShortcut"
                    Directory="TWXSTARTMENUDIR"
                    Name="Mayhem Tradewars Client"
                    Description="Launch Mayhem Tradewars Client"
                    WorkingDirectory="PROGRAMROOTDIR"
                    Advertise="no"
                    Icon="MtcShortcutIcon"
                    IconIndex="0" />
          <Shortcut Id="MtcDesktopShortcut"
                    Directory="DesktopFolder"
                    Name="Mayhem Tradewars Client"
                    Description="Launch Mayhem Tradewars Client"
                    WorkingDirectory="PROGRAMROOTDIR"
                    Advertise="no"
                    Icon="MtcShortcutIcon"
                    IconIndex="0" />
        </File>
      </Component>

    </ComponentGroup>

    <!-- TWX Proxy -->
    <ComponentGroup Id="TwxpPayload">
      <Component Directory="TWXPAPPDIR" Guid="*">
        <File Id="TwxpExeFile"
              Source="$(var.PayloadRoot)\TWXP\twxp.exe"
              KeyPath="yes"
              Checksum="yes">
          <Shortcut Id="TwxpStartMenuShortcut"
                    Directory="TWXSTARTMENUDIR"
                    Name="TWX Proxy"
                    Description="Launch TWX Proxy"
                    WorkingDirectory="PROGRAMROOTDIR"
                    Advertise="no"
                    Icon="TwxpShortcutIcon"
                    IconIndex="0" />
          <Shortcut Id="TwxpDesktopShortcut"
                    Directory="DesktopFolder"
                    Name="TWX Proxy"
                    Description="Launch TWX Proxy"
                    WorkingDirectory="PROGRAMROOTDIR"
                    Advertise="no"
                    Icon="TwxpShortcutIcon"
                    IconIndex="0" />
        </File>
      </Component>

    </ComponentGroup>

    <!-- Compiler Tools: twxc + twxd -->
    <ComponentGroup Id="ToolsPayload">
      <Component Directory="BINDIR" Guid="{6502A2CD-2D83-46BD-B8D6-154A80E5575D}">
        <File Id="TwxcExeFile"
              Source="$(var.PayloadRoot)\ProgramDir\twxc.exe"
              KeyPath="yes"
              Checksum="yes" />
      </Component>

      <Component Directory="BINDIR" Guid="{18E27695-F1A4-43D9-B41E-32E620D3E6BC}">
        <File Id="TwxdExeFile"
              Source="$(var.PayloadRoot)\ProgramDir\twxd.exe"
              KeyPath="yes"
              Checksum="yes" />
      </Component>
    </ComponentGroup>

    <!-- Mombot scripts library (installed under Program Files\TWXProxy\scripts\mombot) -->
    <ComponentGroup Id="ScriptsPayload">
      <Files Directory="SCRIPTSDIR" Include="$(var.PayloadRoot)\scripts\**" />
    </ComponentGroup>

    <ComponentGroup Id="TwxdbAssistantPayload">
      <Files Directory="TWXDBASSISTANTDIR" Include="$(var.PayloadRoot)\ProgramDir\tools\twxdb-assistant\**" />
    </ComponentGroup>

    <ComponentGroup Id="TwxdbAssistantAutoStartPayload">
      <Component Directory="TWXDBASSISTANTDIR" Guid="*">
        <Shortcut Id="TwxdbAssistantStartupShortcut"
                  Directory="CommonStartupFolder"
                  Name="TWXDB Assistant MCP Server"
                  Description="Start the local TWXDB Assistant MCP server"
                  Target="[SystemFolder]wscript.exe"
                  Arguments="&quot;[TWXDBASSISTANTDIR]twxdb-mcp-http.vbs&quot;"
                  WorkingDirectory="TWXDBASSISTANTDIR"
                  Advertise="no" />
        <RegistryValue Root="HKLM"
                       Key="Software\TWXProxy\TWX30"
                       Name="TwxdbAssistantAutoStart"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Complete"
             Title="TWX Proxy Suite"
             Description="All TWX Proxy components."
             Level="1"
             ConfigurableDirectory="PROGRAMROOTDIR">
      <ComponentGroupRef Id="BasePayload" />

      <Feature Id="FeatureMTC"
               Title="Mayhem Tradewars Client"
               Description="Avalonia-based terminal client for TradeWars 2002."
               Level="1">
        <ComponentGroupRef Id="MtcPayload" />
      </Feature>

      <Feature Id="FeatureTWXP"
               Title="TWX Proxy"
               Description="Proxy server and game session manager."
               Level="1">
        <ComponentGroupRef Id="TwxpPayload" />
      </Feature>

      <Feature Id="FeatureTools"
               Title="Compiler Tools"
               Description="TWX script compiler (twxc) and decompiler (twxd)."
               Level="1">
        <ComponentGroupRef Id="ToolsPayload" />
      </Feature>

      <Feature Id="FeatureScripts"
               Title="Mombot Scripts"
               Description="Bundled Mombot script library installed to the scripts\mombot folder."
               Level="1">
        <ComponentGroupRef Id="ScriptsPayload" />
      </Feature>

      <Feature Id="FeatureTwxdbAssistant"
               Title="TWXDB Assistant"
               Description="Local MCP server, query planner model, and private runtimes for TWX30 database questions."
               Level="1">
        <ComponentGroupRef Id="TwxdbAssistantPayload" />

        <Feature Id="FeatureTwxdbAssistantAutoStart"
                 Title="Start TWXDB Assistant at Login"
                 Description="Start the localhost MCP server automatically when Windows starts."
                 Level="2">
          <ComponentGroupRef Id="TwxdbAssistantAutoStartPayload" />
        </Feature>
      </Feature>
    </Feature>
  </Package>
</Wix>
