# Copy this file to ~/.config/twx30/release-signing.env on the Mac that builds
# public release packages. Do not commit the real file.

# Preferred: use a notarytool keychain profile created once with:
#   xcrun notarytool store-credentials twx30-notary
MACOS_NOTARY_PROFILE=twx30-notary

# Optional overrides when auto-detection picks the wrong certificate.
# MACOS_APP_SIGN_IDENTITY="Developer ID Application: NAME (TEAMID)"
# MACOS_INSTALLER_SIGN_IDENTITY="Developer ID Installer: NAME (TEAMID)"

# Alternative to MACOS_NOTARY_PROFILE: use an App Store Connect API key.
# APPLE_API_KEY_ID=
# APPLE_API_ISSUER_ID=
# APPLE_API_KEY_PATH=
